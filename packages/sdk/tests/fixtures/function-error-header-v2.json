{
  "description": "X-B44-Function-Error v2 headers, and what apper's read_function_error(response, version=2) does with each: rejects it, or accepts it and keeps `expected`. Run check-function-error-contract.py against an apper checkout to confirm.",
  "cases": [
    {
      "name": "thrown, at 500",
      "status": 500,
      "header": "{\"v\":2,\"kind\":\"uncaught\",\"message\":\"boom\"}",
      "accept": true,
      "expected": {
        "kind": "uncaught",
        "message": "boom",
        "name": null,
        "fn": null,
        "frames": []
      }
    },
    {
      "name": "thrown in a server function, at 200",
      "status": 200,
      "header": "{\"v\":2,\"kind\":\"uncaught\",\"message\":\"boom\",\"fn\":\"sendInvoice\"}",
      "accept": true,
      "expected": {
        "kind": "uncaught",
        "message": "boom",
        "name": null,
        "fn": "sendInvoice",
        "frames": []
      }
    },
    {
      "name": "thrown in a server function, at 404",
      "status": 404,
      "header": "{\"v\":2,\"kind\":\"uncaught\",\"message\":\"boom\",\"fn\":\"src/server-fns.js:sendInvoice\"}",
      "accept": true,
      "expected": {
        "kind": "uncaught",
        "message": "boom",
        "name": null,
        "fn": "src/server-fns.js:sendInvoice",
        "frames": []
      }
    },
    {
