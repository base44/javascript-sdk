{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@base44/platform": [
        "src/index.ts"
      ],
      "@base44/platform/react": [
        "src/react/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/types/**/*.ts",
    "tests/types/**/*.tsx",
    "examples/**/*.ts"
  ]
}
