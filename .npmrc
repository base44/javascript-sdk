npm_config_registry=https://registry.npmjs.org

; Supply-chain cooldown: npm resolves only versions published at least this long
; ago, so a compromised release cannot enter package-lock.json inside the window.
; Days, and needs npm >= 11.10.0 — Node 24's bundled npm qualifies; older npm
; warns "Unknown project config" and ignores it. Applies to `npm install`/
; `npm update`, not to `npm ci` (resolves nothing) and not to `npx`, which
; fetches uncooled — never fetch tooling with `npx` in a release path.
min-release-age=14
